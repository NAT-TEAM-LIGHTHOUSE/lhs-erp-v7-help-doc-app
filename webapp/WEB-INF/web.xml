<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
  <display-name>Lighthouse ERP Help Centre</display-name>

  <!-- file types Tomcat does not know by default -->
  <mime-mapping>
    <extension>md</extension>
    <mime-type>text/markdown;charset=UTF-8</mime-type>
  </mime-mapping>
  <mime-mapping>
    <extension>webp</extension>
    <mime-type>image/webp</mime-type>
  </mime-mapping>
</web-app>
